# Public Supabase config (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer the classic anon key, or the newer publishable key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Used for auth email redirects (password reset, verify). Defaults to window.origin in the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — NEVER expose to the client / NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_QUALITY=gpt-4o

# Explicit dev fallback for AI — OFF by default
AI_MOCK_MODE=false

# Optional: used by `supabase link` / CLI for remote pushes
# SUPABASE_PROJECT_ID=your-project-ref
# SUPABASE_DB_PASSWORD=your-db-password
